# JWT
JWT_SECRET='secret@2026'

# Admin credentials (used for login — no user DB needed)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="your_strong_password"

# MongoDB — paste full URI including database name
# e.g. mongodb+srv://user:password@cluster.mongodb.net/quickblog
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/quickblog"

# ImageKit (for image uploads)
IMAGEKIT_PUBLIC_KEY="public_xxxxxxxxxxxx"
IMAGEKIT_PRIVATE_KEY="private_xxxxxxxxxxxx"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"

# Google Gemini AI (get free key at https://aistudio.google.com)
GEMINI_API_KEY="AIza..."

# Frontend origin for CORS (defaults to http://localhost:5173)
# For production, add your Vercel frontend URL (comma-separated for multiple):
# FRONTEND_URL="https://quick-blog-client-zeta.vercel.app"
FRONTEND_URL="http://localhost:5173"

# Server port
PORT=3000
